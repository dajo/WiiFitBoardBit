[Unit]
Description=WiiFitBoardBit - Wii Balance Board to Fitbit Scale
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/WiiFitBoardBit
Environment="LD_LIBRARY_PATH=/usr/lib:/usr/local/lib"
Environment="PYTHONPATH=/home/user/.local/lib/python2.7/site-packages:/usr/lib/python2.7/site-packages:/usr/local/lib/python2.7/site-packages"
Environment="PYTHONWARNINGS=ignore::Warning"
ExecStart=/usr/bin/python2 /path/to/WiiFitBoardBit/main.py
Restart=always
RestartSec=10
StandardOutput=append:/path/to/WiiFitBoardBit/log.txt
StandardError=append:/path/to/WiiFitBoardBit/log.txt

# Security settings
PrivateTmp=yes
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
