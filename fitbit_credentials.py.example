# Fitbit OAuth Credentials
# Copy this file to fitbit_credentials.py and fill in your credentials from https://dev.fitbit.com/apps

FITBIT_CLIENT_ID = "YOUR_CLIENT_ID_HERE"
FITBIT_CLIENT_SECRET = "YOUR_CLIENT_SECRET_HERE"

# Fitbit OAuth redirect URL - must match what you set in your Fitbit app settings
# Format: https://YOUR_PI_IP:8080/fitbit_auth_redirect
# Example: https://192.168.1.237:8080/fitbit_auth_redirect
FITBIT_REDIRECT_URL = "https://YOUR_PI_IP:8080/fitbit_auth_redirect"
